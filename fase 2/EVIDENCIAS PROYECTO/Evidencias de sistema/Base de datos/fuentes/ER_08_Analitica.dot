digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=1.5, splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Times New Roman", fontsize=20, labelloc=t, label="RutaAlerta · 08 Analitica\nModelo físico · PK primaria · FK foránea · N admite NULL · extremos min..max"];
node [shape=plain, fontname="Times New Roman"];
edge [fontname="Times New Roman",fontsize=10, color="#555555", arrowsize=0.6, dir=none, labeldistance=2.5];
usuario [id="entity-usuario",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>usuario</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_usuario [ID]</TD></TR></TABLE>>];
organizacion [id="entity-organizacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>organizacion</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_organizacion [ID]</TD></TR></TABLE>>];
version_indicador [id="entity-version_indicador",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>version indicador</B></TD></TR><TR><TD ALIGN="LEFT">PK id_version_indicador : bigint</TD></TR><TR><TD ALIGN="LEFT">codigo : varchar(40)</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR><TR><TD ALIGN="LEFT">nombre : varchar(150)</TD></TR><TR><TD ALIGN="LEFT">definicion : text</TD></TR><TR><TD ALIGN="LEFT">numerador_def : text</TD></TR><TR><TD ALIGN="LEFT">denominador_def : text</TD></TR><TR><TD ALIGN="LEFT">unidad : varchar(40)</TD></TR><TR><TD ALIGN="LEFT">fuentes : text</TD></TR><TR><TD ALIGN="LEFT">limitaciones : text</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR></TABLE>>];
consulta_indicador [id="entity-consulta_indicador",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>consulta indicador</B></TD></TR><TR><TD ALIGN="LEFT">PK id_consulta_indicador : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_version_indicador : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">periodo_desde : timestamptz</TD></TR><TR><TD ALIGN="LEFT">periodo_hasta : timestamptz</TD></TR><TR><TD ALIGN="LEFT">corte_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">filtros : jsonb</TD></TR><TR><TD ALIGN="LEFT">numerador : numeric(18,6) N</TD></TR><TR><TD ALIGN="LEFT">denominador : numeric(18,6) N</TD></TR><TR><TD ALIGN="LEFT">resultado : jsonb N</TD></TR><TR><TD ALIGN="LEFT">entorno : text</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">clave_exportacion_privada : varchar(700) N</TD></TR></TABLE>>];
consulta_indicador -> version_indicador [taillabel="0..*",headlabel="1",label="usa definición"];
consulta_indicador -> usuario [taillabel="0..*",headlabel="1",label="corresponde a"];
consulta_indicador -> organizacion [taillabel="0..*",headlabel="1",label="pertenece a"];
}