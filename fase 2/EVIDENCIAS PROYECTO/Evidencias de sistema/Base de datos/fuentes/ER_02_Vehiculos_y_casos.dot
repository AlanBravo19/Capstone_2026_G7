marca [id="entity-marca",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>marca</B></TD></TR><TR><TD ALIGN="LEFT">PK id_marca : bigint</TD></TR><TR><TD ALIGN="LEFT">nombre : VARCHAR(80)</TD></TR></TABLE>>];
modelo [id="entity-modelo",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>modelo</B></TD></TR><TR><TD ALIGN="LEFT">PK id_modelo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_marca : bigint</TD></TR><TR><TD ALIGN="LEFT">nombre : VARCHAR(100)</TD></TR></TABLE>>];
vehiculo [id="entity-vehiculo",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>vehiculo</B></TD></TR><TR><TD ALIGN="LEFT">PK id_vehiculo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_modelo : bigint</TD></TR><TR><TD ALIGN="LEFT">pais : CHAR(2)</TD></TR><TR><TD ALIGN="LEFT">patente : VARCHAR(16) N</TD></TR><TR><TD ALIGN="LEFT">patente_normalizada : VARCHAR(16)</TD></TR><TR><TD ALIGN="LEFT">color : VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">anio : smallint N</TD></TR><TR><TD ALIGN="LEFT">caracteristicas : TEXT N</TD></TR><TR><TD ALIGN="LEFT">creado_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">tipo_vehiculo : text</TD></TR></TABLE>>];
foto_vehiculo [id="entity-foto_vehiculo",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>foto vehiculo</B></TD></TR><TR><TD ALIGN="LEFT">PK id_foto_vehiculo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_vehiculo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK aportada_por : bigint</TD></TR><TR><TD ALIGN="LEFT">clave_objeto : VARCHAR(700)</TD></TR><TR><TD ALIGN="LEFT">mime : VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">tamano_bytes : bigint</TD></TR><TR><TD ALIGN="LEFT">sha256 : bytea</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR></TABLE>>];
vinculo_vehiculo [id="entity-vinculo_vehiculo",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>vinculo vehiculo</B></TD></TR><TR><TD ALIGN="LEFT">PK id_vinculo_vehiculo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_vehiculo : bigint</TD></TR><TR><TD ALIGN="LEFT">tipo : text</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">inicio : timestamptz</TD></TR><TR><TD ALIGN="LEFT">fin : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">FK revisado_por : bigint N</TD></TR><TR><TD ALIGN="LEFT">revisado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">motivo_revision : VARCHAR(500) N</TD></TR></TABLE>>];
hecho_territorial [id="entity-hecho_territorial",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>hecho territorial</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_hecho_territorial [ID]</TD></TR></TABLE>>];
caso [id="entity-caso",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>caso</B></TD></TR><TR><TD ALIGN="LEFT">PK FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">folio : VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario_reportante : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_vehiculo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_caso_principal : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_hecho_territorial : bigint N</TD></TR><TR><TD ALIGN="LEFT">fecha_hecho : timestamptz</TD></TR><TR><TD ALIGN="LEFT">zona : VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">direccion_privada : VARCHAR(300) N</TD></TR><TR><TD ALIGN="LEFT">ubicacion : geography(Point,4326) N</TD></TR><TR><TD ALIGN="LEFT">precision_m : DECIMAL(10,2) N</TD></TR><TR><TD ALIGN="LEFT">descripcion_privada : TEXT</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">prioridad : text</TD></TR><TR><TD ALIGN="LEFT">denuncia_estado : text</TD></TR><TR><TD ALIGN="LEFT">referencia_denuncia : VARCHAR(120) N</TD></TR><TR><TD ALIGN="LEFT">motivo_cierre : text N</TD></TR><TR><TD ALIGN="LEFT">cerrado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">entorno : text</TD></TR><TR><TD ALIGN="LEFT">clave_envio : uuid</TD></TR><TR><TD ALIGN="LEFT">creado_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">actualizado_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">tipo_incidente : text</TD></TR><TR><TD ALIGN="LEFT">recuperado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">FK id_evidencia_recuperacion : bigint N</TD></TR></TABLE>>];
asignacion_caso [id="entity-asignacion_caso",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>asignacion caso</B></TD></TR><TR><TD ALIGN="LEFT">PK id_asignacion_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_membresia : bigint</TD></TR><TR><TD ALIGN="LEFT">FK asignado_por : bigint</TD></TR><TR><TD ALIGN="LEFT">inicio : timestamptz</TD></TR><TR><TD ALIGN="LEFT">fin : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">motivo : VARCHAR(500)</TD></TR></TABLE>>];
gestion_caso [id="entity-gestion_caso",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>gestion caso</B></TD></TR><TR><TD ALIGN="LEFT">PK id_gestion_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">accion : VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">estado_anterior : VARCHAR(30) N</TD></TR><TR><TD ALIGN="LEFT">estado_nuevo : VARCHAR(30) N</TD></TR><TR><TD ALIGN="LEFT">descripcion : TEXT</TD></TR><TR><TD ALIGN="LEFT">visibilidad : text</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR></TABLE>>];
evidencia [id="entity-evidencia",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>evidencia</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_evidencia [ID]</TD></TR></TABLE>>];
canal_derivacion [id="entity-canal_derivacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>canal derivacion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_canal_derivacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">institucion_destino : VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">tipo : text</TD></TR><TR><TD ALIGN="LEFT">descripcion_canal : VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">referencia_acuerdo : VARCHAR(200) N</TD></TR><TR><TD ALIGN="LEFT">habilitado : BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">verificado_en : timestamptz N</TD></TR></TABLE>>];
derivacion_caso [id="entity-derivacion_caso",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>derivacion caso</B></TD></TR><TR><TD ALIGN="LEFT">PK id_derivacion_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_canal_derivacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario_responsable : bigint</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">enviada_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">confirmada_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">referencia_recepcion : VARCHAR(200) N</TD></TR><TR><TD ALIGN="LEFT">observacion : VARCHAR(500) N</TD></TR></TABLE>>];
