digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=1.5, splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Times New Roman", fontsize=20, labelloc=t, label="RutaAlerta · 06 Camaras y busqueda\nModelo físico · PK primaria · FK foránea · N admite NULL · extremos min..max"];
node [shape=plain, fontname="Times New Roman"];
edge [fontname="Times New Roman",fontsize=10, color="#555555", arrowsize=0.6, dir=none, labeldistance=2.5];
usuario [id="entity-usuario",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>usuario</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_usuario [ID]</TD></TR></TABLE>>];
organizacion [id="entity-organizacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>organizacion</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_organizacion [ID]</TD></TR></TABLE>>];
caso [id="entity-caso",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>caso</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_caso [ID]</TD></TR></TABLE>>];
avistamiento [id="entity-avistamiento",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>avistamiento</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_avistamiento [ID]</TD></TR></TABLE>>];
evidencia [id="entity-evidencia",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>evidencia</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_evidencia [ID]</TD></TR></TABLE>>];
camara [id="entity-camara",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>camara</B></TD></TR><TR><TD ALIGN="LEFT">PK id_camara : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">nombre : varchar(120)</TD></TR><TR><TD ALIGN="LEFT">ubicacion : geography(Point,4326)</TD></TR><TR><TD ALIGN="LEFT">cobertura : geometry(MultiPolygon,4326) N</TD></TR><TR><TD ALIGN="LEFT">orientacion_grados : numeric(6,2) N</TD></TR><TR><TD ALIGN="LEFT">capacidades : jsonb</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">referencia_autorizacion : text</TD></TR><TR><TD ALIGN="LEFT">referencia_secreto : varchar(200) N</TD></TR><TR><TD ALIGN="LEFT">zona_horaria : varchar(64)</TD></TR><TR><TD ALIGN="LEFT">desfase_reloj_seg : numeric(10,3) N</TD></TR><TR><TD ALIGN="LEFT">verificada_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">entorno : text</TD></TR></TABLE>>];
sesion_busqueda [id="entity-sesion_busqueda",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>sesion busqueda</B></TD></TR><TR><TD ALIGN="LEFT">PK FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK creada_por : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_observacion_ancla : bigint N</TD></TR><TR><TD ALIGN="LEFT">inicio : timestamptz</TD></TR><TR><TD ALIGN="LEFT">fin : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">version_mapa : varchar(100)</TD></TR><TR><TD ALIGN="LEFT">version_metodo : varchar(60)</TD></TR><TR><TD ALIGN="LEFT">parametros : jsonb</TD></TR></TABLE>>];
observacion_busqueda [id="entity-observacion_busqueda",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>observacion busqueda</B></TD></TR><TR><TD ALIGN="LEFT">PK id_observacion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_avistamiento : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_evidencia : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_camara : bigint N</TD></TR><TR><TD ALIGN="LEFT">origen : text</TD></TR><TR><TD ALIGN="LEFT">observado_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">recibido_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">ubicacion : geography(Point,4326)</TD></TR><TR><TD ALIGN="LEFT">precision_m : numeric(10,2)</TD></TR><TR><TD ALIGN="LEFT">direccion_grados : numeric(6,2) N</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">FK revisado_por : bigint N</TD></TR><TR><TD ALIGN="LEFT">revisado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">motivo_revision : text N</TD></TR></TABLE>>];
hipotesis_ruta [id="entity-hipotesis_ruta",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>hipotesis ruta</B></TD></TR><TR><TD ALIGN="LEFT">PK id_hipotesis_ruta : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_observacion_ancla : bigint</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR><TR><TD ALIGN="LEFT">geometria : geometry(MultiLineString,4326)</TD></TR><TR><TD ALIGN="LEFT">desde : timestamptz</TD></TR><TR><TD ALIGN="LEFT">hasta : timestamptz</TD></TR><TR><TD ALIGN="LEFT">supuestos : jsonb</TD></TR><TR><TD ALIGN="LEFT">factores : jsonb</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">motivo_actualizacion : text</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR></TABLE>>];
recomendacion_camara [id="entity-recomendacion_camara",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>recomendacion camara</B></TD></TR><TR><TD ALIGN="LEFT">PK id_recomendacion_camara : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_hipotesis_ruta : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_camara : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">desde : timestamptz</TD></TR><TR><TD ALIGN="LEFT">hasta : timestamptz</TD></TR><TR><TD ALIGN="LEFT">prioridad : numeric(10,4)</TD></TR><TR><TD ALIGN="LEFT">factores : jsonb</TD></TR><TR><TD ALIGN="LEFT">disponibilidad : text</TD></TR><TR><TD ALIGN="LEFT">generada_en : timestamptz</TD></TR></TABLE>>];
revision_recomendacion [id="entity-revision_recomendacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>revision recomendacion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_revision_recomendacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_recomendacion_camara : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">decision : text</TD></TR><TR><TD ALIGN="LEFT">motivo : text</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR></TABLE>>];
consulta_video [id="entity-consulta_video",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>consulta video</B></TD></TR><TR><TD ALIGN="LEFT">PK id_consulta_video : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_organizacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_camara : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">modalidad : text</TD></TR><TR><TD ALIGN="LEFT">desde : timestamptz</TD></TR><TR><TD ALIGN="LEFT">hasta : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">resultado : text</TD></TR><TR><TD ALIGN="LEFT">motivo : text</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR></TABLE>>];
camara -> organizacion [taillabel="0..*",headlabel="1",label="pertenece a"];
