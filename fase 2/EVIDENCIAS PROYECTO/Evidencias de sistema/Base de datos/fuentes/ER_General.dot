digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=1.5, splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Times New Roman", fontsize=20, labelloc=t, label="RutaAlerta · Esquema PostgreSQL y PostGIS\nModelo físico · PK primaria · FK foránea · N admite NULL · extremos min..max"];
node [shape=plain, fontname="Times New Roman"];
edge [fontname="Times New Roman",fontsize=10, color="#555555", arrowsize=0.6, dir=none, labeldistance=2.5];
