digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=1.5, splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Times New Roman", fontsize=20, labelloc=t, label="RutaAlerta · 05 Notificaciones y evaluacion\nModelo físico · PK primaria · FK foránea · N admite NULL · extremos min..max"];
node [shape=plain, fontname="Times New Roman"];
edge [fontname="Times New Roman",fontsize=10, color="#555555", arrowsize=0.6, dir=none, labeldistance=2.5];
usuario [id="entity-usuario",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>usuario</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_usuario [ID]</TD></TR></TABLE>>];
dispositivo [id="entity-dispositivo",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>dispositivo</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_dispositivo [ID]</TD></TR></TABLE>>];
caso [id="entity-caso",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>caso</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_caso [ID]</TD></TR></TABLE>>];
aviso_territorial [id="entity-aviso_territorial",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>aviso territorial</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_aviso_territorial [ID]</TD></TR></TABLE>>];
notificacion [id="entity-notificacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>notificacion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_notificacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_aviso_territorial : bigint N</TD></TR><TR><TD ALIGN="LEFT">tipo : text</TD></TR><TR><TD ALIGN="LEFT">titulo : VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">mensaje : VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">clave_deduplicacion : VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">leida_en : timestamptz N</TD></TR></TABLE>>];
entrega_notificacion [id="entity-entrega_notificacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>entrega notificacion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_entrega_notificacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_notificacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_dispositivo : bigint N</TD></TR><TR><TD ALIGN="LEFT">canal : text</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">clave_entrega : VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">intentos : integer</TD></TR><TR><TD ALIGN="LEFT">proximo_intento_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">procesado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">confirmado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">ultimo_error : VARCHAR(500) N</TD></TR></TABLE>>];
evento_salida [id="entity-evento_salida",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>evento salida</B></TD></TR><TR><TD ALIGN="LEFT">PK id_evento_salida : bigint</TD></TR><TR><TD ALIGN="LEFT">tipo : VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">agregado_tipo : VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">agregado_id : bigint</TD></TR><TR><TD ALIGN="LEFT">clave_evento : VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">payload : jsonb</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">intentos : integer</TD></TR><TR><TD ALIGN="LEFT">disponible_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">bloqueado_hasta : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">creado_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">publicado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">ultimo_error : VARCHAR(500) N</TD></TR></TABLE>>];
evento_auditoria [id="entity-evento_auditoria",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>evento auditoria</B></TD></TR><TR><TD ALIGN="LEFT">PK id_evento_auditoria : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint N</TD></TR><TR><TD ALIGN="LEFT">accion : VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">objeto_tipo : VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">objeto_id : VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">resultado : text</TD></TR><TR><TD ALIGN="LEFT">correlacion : uuid</TD></TR><TR><TD ALIGN="LEFT">resumen : VARCHAR(500) N</TD></TR><TR><TD ALIGN="LEFT">creado_en : timestamptz</TD></TR></TABLE>>];
escenario_prueba [id="entity-escenario_prueba",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>escenario prueba</B></TD></TR><TR><TD ALIGN="LEFT">PK id_escenario_prueba : bigint</TD></TR><TR><TD ALIGN="LEFT">codigo : VARCHAR(40)</TD></TR><TR><TD ALIGN="LEFT">objetivo : text</TD></TR><TR><TD ALIGN="LEFT">version : smallint</TD></TR><TR><TD ALIGN="LEFT">instrucciones : TEXT</TD></TR><TR><TD ALIGN="LEFT">resultado_esperado : TEXT</TD></TR><TR><TD ALIGN="LEFT">datos_sinteticos : jsonb</TD></TR></TABLE>>];
ejecucion_prueba [id="entity-ejecucion_prueba",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>ejecucion prueba</B></TD></TR><TR><TD ALIGN="LEFT">PK id_ejecucion_prueba : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_escenario_prueba : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario_evaluador : bigint</TD></TR><TR><TD ALIGN="LEFT">participante_codigo : VARCHAR(40) N</TD></TR><TR><TD ALIGN="LEFT">modalidad : text</TD></TR><TR><TD ALIGN="LEFT">condicion_red : VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">dispositivo : VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">resultado : text</TD></TR><TR><TD ALIGN="LEFT">entorno : text</TD></TR><TR><TD ALIGN="LEFT">inicio : timestamptz</TD></TR><TR><TD ALIGN="LEFT">fin : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">pareja_codigo : varchar(80) N</TD></TR><TR><TD ALIGN="LEFT">orden_presentacion : smallint N</TD></TR></TABLE>>];
medicion [id="entity-medicion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>medicion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_medicion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_ejecucion_prueba : bigint</TD></TR><TR><TD ALIGN="LEFT">indicador : VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">valor : DECIMAL(16,6)</TD></TR><TR><TD ALIGN="LEFT">unidad : VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">inicio : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">fin : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">observacion : VARCHAR(500) N</TD></TR></TABLE>>];
notificacion -> usuario [taillabel="0..*",headlabel="1",label="corresponde a"];
notificacion -> caso [taillabel="0..*",headlabel="0..1",label="pertenece al caso"];
notificacion -> aviso_territorial [taillabel="0..*",headlabel="0..1",label="referencia"];
entrega_notificacion -> notificacion [taillabel="0..*",headlabel="1",label="entrega aviso"];
entrega_notificacion -> dispositivo [taillabel="0..*",headlabel="0..1",label="referencia"];
evento_auditoria -> usuario [taillabel="0..*",headlabel="0..1",label="corresponde a"];
ejecucion_prueba -> escenario_prueba [taillabel="0..*",headlabel="1",label="ejecuta escenario"];
ejecucion_prueba -> usuario [taillabel="0..*",headlabel="1",label="usuario evaluador"];
medicion -> ejecucion_prueba [taillabel="0..*",headlabel="1",label="mide ejecución"];
}