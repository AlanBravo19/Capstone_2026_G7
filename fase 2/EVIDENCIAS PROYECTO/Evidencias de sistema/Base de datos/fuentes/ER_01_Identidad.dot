preferencia [id="entity-preferencia",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>preferencia</B></TD></TR><TR><TD ALIGN="LEFT">PK id_preferencia : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">avisos_caso : BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">avisos_territoriales : BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">push_habilitado : BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">correo_habilitado : BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">silencio_desde : TIME N</TD></TR><TR><TD ALIGN="LEFT">silencio_hasta : TIME N</TD></TR><TR><TD ALIGN="LEFT">zona_horaria : VARCHAR(64)</TD></TR><TR><TD ALIGN="LEFT">actualizado_en : timestamptz</TD></TR></TABLE>>];
