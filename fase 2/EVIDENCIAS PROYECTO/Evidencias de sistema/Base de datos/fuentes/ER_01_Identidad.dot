digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=1.5, splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Times New Roman", fontsize=20, labelloc=t, label="RutaAlerta · 01 Identidad\nModelo físico · PK primaria · FK foránea · N admite NULL · extremos min..max"];
