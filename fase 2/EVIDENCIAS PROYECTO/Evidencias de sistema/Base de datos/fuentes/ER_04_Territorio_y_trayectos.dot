digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=1.5, splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Times New Roman", fontsize=20, labelloc=t, label="RutaAlerta · 04 Territorio y trayectos\nModelo físico · PK primaria · FK foránea · N admite NULL · extremos min..max"];
node [shape=plain, fontname="Times New Roman"];
edge [fontname="Times New Roman",fontsize=10, color="#555555", arrowsize=0.6, dir=none, labeldistance=2.5];
usuario [id="entity-usuario",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>usuario</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_usuario [ID]</TD></TR></TABLE>>];
hecho_territorial [id="entity-hecho_territorial",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>hecho territorial</B></TD></TR><TR><TD ALIGN="LEFT">PK id_hecho_territorial : bigint</TD></TR><TR><TD ALIGN="LEFT">tipo : text</TD></TR><TR><TD ALIGN="LEFT">ocurrido_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">zona : VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">ubicacion : geography(Point,4326) N</TD></TR><TR><TD ALIGN="LEFT">precision_m : DECIMAL(10,2) N</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">nivel_agregacion : text</TD></TR><TR><TD ALIGN="LEFT">FK validado_por : bigint N</TD></TR><TR><TD ALIGN="LEFT">validado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">entorno : text</TD></TR></TABLE>>];
fuente_datos [id="entity-fuente_datos",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>fuente datos</B></TD></TR><TR><TD ALIGN="LEFT">PK id_fuente_datos : bigint</TD></TR><TR><TD ALIGN="LEFT">nombre : VARCHAR(180)</TD></TR><TR><TD ALIGN="LEFT">procedencia : VARCHAR(1000)</TD></TR><TR><TD ALIGN="LEFT">condiciones_uso : TEXT</TD></TR><TR><TD ALIGN="LEFT">cobertura : VARCHAR(250)</TD></TR><TR><TD ALIGN="LEFT">revisada_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR></TABLE>>];
lote_importacion [id="entity-lote_importacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>lote importacion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_lote_importacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_fuente_datos : bigint</TD></TR><TR><TD ALIGN="LEFT">FK importado_por : bigint</TD></TR><TR><TD ALIGN="LEFT">sha256 : bytea</TD></TR><TR><TD ALIGN="LEFT">cantidad : integer</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">observaciones : TEXT N</TD></TR><TR><TD ALIGN="LEFT">creado_en : timestamptz</TD></TR></TABLE>>];
registro_fuente [id="entity-registro_fuente",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>registro fuente</B></TD></TR><TR><TD ALIGN="LEFT">PK id_registro_fuente : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_lote_importacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_fuente_datos : bigint</TD></TR><TR><TD ALIGN="LEFT">identificador_origen : VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">FK id_hecho_territorial : bigint N</TD></TR><TR><TD ALIGN="LEFT">fecha_hecho : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">zona : VARCHAR(200) N</TD></TR><TR><TD ALIGN="LEFT">ubicacion : geography(Point,4326) N</TD></TR><TR><TD ALIGN="LEFT">precision_m : DECIMAL(10,2) N</TD></TR><TR><TD ALIGN="LEFT">estado_revision : text</TD></TR><TR><TD ALIGN="LEFT">FK revisado_por : bigint N</TD></TR><TR><TD ALIGN="LEFT">revisado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">motivo_revision : VARCHAR(500) N</TD></TR></TABLE>>];
consulta_ruta [id="entity-consulta_ruta",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>consulta ruta</B></TD></TR><TR><TD ALIGN="LEFT">PK id_consulta_ruta : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">origen : geography(Point,4326)</TD></TR><TR><TD ALIGN="LEFT">destino : geography(Point,4326)</TD></TR><TR><TD ALIGN="LEFT">version_metodo : VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">cobertura : text</TD></TR><TR><TD ALIGN="LEFT">entorno : text</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR></TABLE>>];
alternativa_ruta [id="entity-alternativa_ruta",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>alternativa ruta</B></TD></TR><TR><TD ALIGN="LEFT">PK id_alternativa_ruta : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_consulta_ruta : bigint</TD></TR><TR><TD ALIGN="LEFT">numero : smallint</TD></TR><TR><TD ALIGN="LEFT">geometria : geometry(LineString,4326)</TD></TR><TR><TD ALIGN="LEFT">duracion_seg : integer</TD></TR><TR><TD ALIGN="LEFT">distancia_m : integer</TD></TR><TR><TD ALIGN="LEFT">exposicion_relativa : DECIMAL(12,6) N</TD></TR><TR><TD ALIGN="LEFT">explicacion : TEXT</TD></TR><TR><TD ALIGN="LEFT">datos_suficientes : BOOLEAN</TD></TR></TABLE>>];
trayecto [id="entity-trayecto",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>trayecto</B></TD></TR><TR><TD ALIGN="LEFT">PK id_trayecto : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_consulta_ruta : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_alternativa_ruta : bigint N</TD></TR><TR><TD ALIGN="LEFT">inicio : timestamptz</TD></TR><TR><TD ALIGN="LEFT">fin : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">modo_avisos : text</TD></TR><TR><TD ALIGN="LEFT">permisos_disponibles : jsonb</TD></TR></TABLE>>];
aviso_territorial [id="entity-aviso_territorial",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>aviso territorial</B></TD></TR><TR><TD ALIGN="LEFT">PK id_aviso_territorial : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_trayecto : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_hecho_territorial : bigint</TD></TR><TR><TD ALIGN="LEFT">zona : VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">motivo : VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">generado_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">presentado_en : timestamptz N</TD></TR></TABLE>>];
hecho_territorial -> usuario [taillabel="0..*",headlabel="0..1",label="validado por"];
lote_importacion -> fuente_datos [taillabel="0..*",headlabel="1",label="proviene de"];
lote_importacion -> usuario [taillabel="0..*",headlabel="1",label="importado por"];
registro_fuente -> lote_importacion [taillabel="0..*",headlabel="1",label="pertenece al lote"];
registro_fuente -> hecho_territorial [taillabel="0..*",headlabel="0..1",label="consolida o referencia"];
registro_fuente -> usuario [taillabel="0..*",headlabel="0..1",label="revisado por"];
consulta_ruta -> usuario [taillabel="0..*",headlabel="1",label="corresponde a"];
alternativa_ruta -> consulta_ruta [taillabel="0..*",headlabel="1",label="responde a consulta"];
trayecto -> usuario [taillabel="0..*",headlabel="1",label="corresponde a"];
trayecto -> consulta_ruta [taillabel="0..*",headlabel="0..1",label="responde a consulta"];
trayecto -> alternativa_ruta [taillabel="0..*",headlabel="0..1",label="selecciona alternativa"];
aviso_territorial -> trayecto [taillabel="0..*",headlabel="1",label="ocurre durante"];
aviso_territorial -> hecho_territorial [taillabel="0..*",headlabel="1",label="consolida o referencia"];
}