digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.45, ranksep=1.5, splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Times New Roman", fontsize=20, labelloc=t, label="RutaAlerta · 07 Asistencia IA\nModelo físico · PK primaria · FK foránea · N admite NULL · extremos min..max"];
node [shape=plain, fontname="Times New Roman"];
edge [fontname="Times New Roman",fontsize=10, color="#555555", arrowsize=0.6, dir=none, labeldistance=2.5];
usuario [id="entity-usuario",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>usuario</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_usuario [ID]</TD></TR></TABLE>>];
evidencia [id="entity-evidencia",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>evidencia</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_evidencia [ID]</TD></TR></TABLE>>];
sesion_busqueda [id="entity-sesion_busqueda",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>sesion busqueda</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_sesion_busqueda [ID]</TD></TR></TABLE>>];
observacion_busqueda [id="entity-observacion_busqueda",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>observacion busqueda</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_observacion_busqueda [ID]</TD></TR></TABLE>>];
recomendacion_camara [id="entity-recomendacion_camara",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>recomendacion camara</B> [referencia]</TD></TR><TR><TD ALIGN="LEFT">id_recomendacion_camara [ID]</TD></TR></TABLE>>];
version_modelo [id="entity-version_modelo",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>version modelo</B></TD></TR><TR><TD ALIGN="LEFT">PK id_version_modelo : bigint</TD></TR><TR><TD ALIGN="LEFT">nombre : varchar(120)</TD></TR><TR><TD ALIGN="LEFT">version : varchar(80)</TD></TR><TR><TD ALIGN="LEFT">sha256 : bytea</TD></TR><TR><TD ALIGN="LEFT">licencia : text</TD></TR><TR><TD ALIGN="LEFT">finalidad : text</TD></TR><TR><TD ALIGN="LEFT">limitaciones : text</TD></TR><TR><TD ALIGN="LEFT">referencia_evaluacion : text N</TD></TR><TR><TD ALIGN="LEFT">registrada_en : timestamptz</TD></TR></TABLE>>];
ejecucion_modelo [id="entity-ejecucion_modelo",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>ejecucion modelo</B></TD></TR><TR><TD ALIGN="LEFT">PK id_ejecucion_modelo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_version_modelo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_evidencia_referencia : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">parametros : jsonb</TD></TR><TR><TD ALIGN="LEFT">inicio : timestamptz</TD></TR><TR><TD ALIGN="LEFT">fin : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">costo_estimado : numeric(12,6) N</TD></TR><TR><TD ALIGN="LEFT">moneda : char(3) N</TD></TR><TR><TD ALIGN="LEFT">error : text N</TD></TR></TABLE>>];
candidato_visual [id="entity-candidato_visual",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>candidato visual</B></TD></TR><TR><TD ALIGN="LEFT">PK id_candidato_visual : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_ejecucion_modelo : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_caso : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_evidencia : bigint</TD></TR><TR><TD ALIGN="LEFT">rango : integer</TD></TR><TR><TD ALIGN="LEFT">puntaje : numeric(12,6)</TD></TR><TR><TD ALIGN="LEFT">factores : jsonb</TD></TR><TR><TD ALIGN="LEFT">clave_recorte_privado : varchar(700) N</TD></TR><TR><TD ALIGN="LEFT">decision : text</TD></TR><TR><TD ALIGN="LEFT">FK revisado_por : bigint N</TD></TR><TR><TD ALIGN="LEFT">revisado_en : timestamptz N</TD></TR><TR><TD ALIGN="LEFT">motivo_revision : text N</TD></TR></TABLE>>];
consulta_copiloto [id="entity-consulta_copiloto",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>consulta copiloto</B></TD></TR><TR><TD ALIGN="LEFT">PK id_consulta_copiloto : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_usuario : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_ejecucion_modelo : bigint N</TD></TR><TR><TD ALIGN="LEFT">pregunta : text</TD></TR><TR><TD ALIGN="LEFT">estado : text</TD></TR><TR><TD ALIGN="LEFT">respuesta : text N</TD></TR><TR><TD ALIGN="LEFT">creada_en : timestamptz</TD></TR><TR><TD ALIGN="LEFT">respondida_en : timestamptz N</TD></TR></TABLE>>];
afirmacion_copiloto [id="entity-afirmacion_copiloto",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>afirmacion copiloto</B></TD></TR><TR><TD ALIGN="LEFT">PK id_afirmacion_copiloto : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_consulta_copiloto : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">orden : integer</TD></TR><TR><TD ALIGN="LEFT">texto : text</TD></TR><TR><TD ALIGN="LEFT">tipo : text</TD></TR><TR><TD ALIGN="LEFT">estado_revision : text</TD></TR></TABLE>>];
soporte_afirmacion [id="entity-soporte_afirmacion",label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd"><B>soporte afirmacion</B></TD></TR><TR><TD ALIGN="LEFT">PK id_soporte_afirmacion : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_afirmacion_copiloto : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_sesion_busqueda : bigint</TD></TR><TR><TD ALIGN="LEFT">FK id_observacion_busqueda : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_candidato_visual : bigint N</TD></TR><TR><TD ALIGN="LEFT">FK id_recomendacion_camara : bigint N</TD></TR></TABLE>>];
ejecucion_modelo -> sesion_busqueda [taillabel="0..*",headlabel="1",label="integra la sesión"];
