# Referencia de variables: esta entrega NO carga .env automáticamente.
# Usar Iniciar_API_Demo.ps1 o configurar el entorno según la guía.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=ra_api.PROJECT_REF
DB_PASSWORD=cambiar_esto
SESION_HORAS=12
RECUPERACION_MINUTOS=30
ENTORNO=prueba
CANALES_DEMO=1
DB_SSL=1
DEMO_ACCESS_KEY=generar_secreto_aleatorio_de_al_menos_24_caracteres
OTP_SECRET=generar_secreto_aleatorio_de_al_menos_32_caracteres
# OTP_SECRET: generar un secreto aleatorio de al menos 32 bytes si se necesita
# conservar desafíos entre reinicios locales. No subir el valor al repositorio.

# Envío real de verificación y recuperación. No activar sin comprobar la entrega.
# CORREO_TRANSPORTE=smtp nunca devuelve códigos por la API.
CORREO_TRANSPORTE=demo
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
